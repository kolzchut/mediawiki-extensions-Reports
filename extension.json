{
	"name": "KolzchutReports",
	"version": "0.2.2",
	"author": [
		"Dror S. [FFS] ([https://www.kolzchut.org.il Kol-Zchut])"
	],
	"url": "https://github.com/kolzchut/mediawiki-extensions-Reports",
	"descriptionmsg": "reports-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"SpecialPages": {
		"ArticlesUpdatesReport": {
			"class": "MediaWiki\\Extension\\KolzchutReports\\SpecialArticlesUpdatesReport",
			"services": [
				"ConnectionProvider",
				"CommentStore",
				"TitleParser"
			]
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\KolzchutReports\\": "includes/"
	},
	"AvailableRights": [
		"viewreports"
	],
	"GroupPermissions": {
		"staff": {
			"viewreports": true
		}
	},
	"MessagesDirs": {
		"KolzchutReports": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"KolzchutReportsAlias": "Reports.alias.php"
	},
	"ResourceModules": {
		"ext.wikirights.reports": {
			"styles": [
				"modules/ext.wikirights.reports.css"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "WikiRights/Reports"
	},
	"manifest_version": 2
}
